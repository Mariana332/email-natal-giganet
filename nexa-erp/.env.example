# Copie este arquivo para .env e preencha com os valores reais.
# Na Vercel: Settings -> Environment Variables (lembre de marcar também o ambiente "Preview").

# Connection string do Postgres (ex: Neon, Supabase, Railway, Postgres local).
DATABASE_URL="postgresql://usuario:senha@host:5432/nome_do_banco"

# Chave usada pelo NextAuth para assinar sessões. Gere uma em https://generate-secret.vercel.app/32
# ou rodando `npx auth secret` na raiz do projeto.
AUTH_SECRET="troque-por-uma-chave-aleatoria"
